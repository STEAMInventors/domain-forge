{
  "name": "@hive/pack-contract",
  "version": "0.1.0",
  "description": "Hive-shared Domain Pack contract — not Forge-specific",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
