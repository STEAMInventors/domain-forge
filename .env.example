FORGE_EXTRACTION_MODEL_VERSION=\nFORGE_RESEARCH_MODEL_VERSION=\nFORGE_FIXTURE_MODEL_VERSION=\nFORGE_ADVERSARIAL_MODEL_VERSION=\nFORGE_RULE_MODEL_VERSION=\n﻿# ============================================================
# Domain Forge
# ============================================================

NODE_ENV=development


# ============================================================
# MODEL PROVIDERS
# Secrets belong in .env only.
# Never commit real API keys.
# ============================================================

OPENAI_API_KEY=

ANTHROPIC_API_KEY=


# ============================================================
# STAGE 6 — RULE GENERATION
#
# Model proposes domain rules.
# Output remains untrusted until Forge validation succeeds.
# ============================================================

FORGE_RULE_PROVIDER=openai
FORGE_RULE_MODEL=gpt-5.6-sol
FORGE_RULE_MODEL_FAMILY=gpt-5.6

# Provider-neutral reasoning policy interpreted by adapter.
FORGE_RULE_REASONING=max


# ============================================================
# STAGE 7 — ADVERSARIAL REVIEW
#
# MUST be independent from Stage 6.
# Runtime must reject same provider + model-family identity
# unless explicitly permitted by ADR.
# ============================================================

FORGE_ADVERSARIAL_PROVIDER=anthropic
FORGE_ADVERSARIAL_MODEL=claude-opus-5
FORGE_ADVERSARIAL_MODEL_FAMILY=claude-opus-5

FORGE_ADVERSARIAL_REASONING=high


# ============================================================
# STAGE 8 — FIXTURE GENERATION
#
# Separate invocation from Stage 6 is mandatory.
# Different provider/family is preferred.
# Start with Anthropic; may be optimized later.
# ============================================================

FORGE_FIXTURE_PROVIDER=anthropic
FORGE_FIXTURE_MODEL=claude-sonnet-5
FORGE_FIXTURE_MODEL_FAMILY=claude-sonnet-5

FORGE_FIXTURE_REASONING=high


# ============================================================
# RESEARCH / EXTRACTION
#
# Do NOT give models provider-native web access.
# All source search/fetch must go through Forge tooling.
# ============================================================

FORGE_RESEARCH_PROVIDER=openai
FORGE_RESEARCH_MODEL=gpt-5.6-sol
FORGE_RESEARCH_MODEL_FAMILY=gpt-5.6

FORGE_EXTRACTION_PROVIDER=anthropic
FORGE_EXTRACTION_MODEL=claude-sonnet-5
FORGE_EXTRACTION_MODEL_FAMILY=claude-sonnet-5


# ============================================================
# MODEL TOOL POLICY
# Authoritative research must always use Forge SearchProvider /
# SourceRetriever so sources can be snapshotted and verified.
# ============================================================

FORGE_ALLOW_PROVIDER_WEB_SEARCH=false
FORGE_ALLOW_PROVIDER_URL_FETCH=false


# ============================================================
# RULE ↔ ADVERSARIAL LOOP
# ============================================================

FORGE_MAX_RULE_REVIEW_ROUNDS=3


# ============================================================
# RUN BUDGETS
#
# Set real values after observing early Forge runs.
# 0 means no monetary cap in development ONLY if code explicitly
# interprets it that way. Production should require a finite cap.
# ============================================================

FORGE_MAX_MODEL_INVOCATIONS=100
FORGE_MAX_INPUT_TOKENS=1000000
FORGE_MAX_OUTPUT_TOKENS=250000
FORGE_MAX_TOTAL_TOKENS=1250000

FORGE_MAX_RUN_COST_USD=0


# ============================================================
# STORAGE — BOOTSTRAP
# ============================================================

FORGE_STORAGE_ADAPTER=json
FORGE_DATA_DIR=.forge/data


# ============================================================
# LOGGING
# ============================================================

LOG_LEVEL=info

FORGE_LOG_MODEL_RESPONSES=false
FORGE_LOG_SOURCE_CONTENT=false
FORGE_REDACT_SECRETS=true
