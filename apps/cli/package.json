{
  "name": "@domain-forge/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": { "forge": "./dist/index.js" },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
